<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My AI Chatbot</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; padding: 20px; }
        #chatbox { border: 1px solid #ccc; height: 300px; overflow-y: scroll; padding: 10px; margin-bottom: 10px; }
        input { width: 80%; padding: 10px; }
        button { padding: 10px; }
    </style>
</head>
<body>

    <h2>AI Chatbot</h2>
    <div id="chatbox"></div>
    <input type="text" id="userInput" placeholder="Type a message..." />
    <button onclick="sendMessage()">Send</button>

    <script>
        const messages = [{ role: "system", content: "You are a helpful assistant." }];

        async function sendMessage() {
            const inputField = document.getElementById("userInput");
            const chatbox = document.getElementById("chatbox");
            const userText = inputField.value;
            if (!userText) return;

            // Display user message
            chatbox.innerHTML += `<div><b>You:</b> ${userText}</div>`;
            messages.push({ role: "user", content: userText });
            inputField.value = "";

            try {
                // Send request to your Node.js backend
                const response = await fetch("http://localhost:3000/api/chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ messages })
                });

                const data = await response.json();
                
                // Display bot response
                chatbox.innerHTML += `<div><b>Bot:</b> ${data.reply}</div>`;
                messages.push({ role: "assistant", content: data.reply });
                chatbox.scrollTop = chatbox.scrollHeight;
            } catch (error) {
                chatbox.innerHTML += `<div><b>Error:</b> Could not connect to server.</div>`;
            }
        }
    </script>
</body>
</html>
